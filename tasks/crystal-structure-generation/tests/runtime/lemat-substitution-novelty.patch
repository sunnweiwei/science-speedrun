+"""Disorder-aware matching against ordered references (CrystalGen task patch).
+
+A dilute substitution of a known compound, such as one Gd on a Dy site of DyCu, is an ordered
+approximant of a solid solution rather than a new material (MatterGen, Nature 2025, matches with
+compositional disorder for this reason). LeMat-Bulk holds only ordered DFT entries, so MatterGen's
+disordered matcher cannot apply directly: an ordered variant has a different formula from its
+ordered parent. Instead, a structure is compared with the structures obtained by merging a dilute
+substituent back into its host.
+
+- Two elements can substitute under MatterGen's modified Hume-Rothery rule: relative atomic-radius
+  difference <= 0.3 and electronegativity difference <= 1.0
+  (mattergen/evaluation/utils/structure_matcher.py, MIT).
+- A substitution is dilute when the substituent holds at most a quarter of the sites the pair
+  occupies. On MP-20 test materials, only 8 % are such a variant of another LeMat-Bulk entry (23 %
+  at one third, 43 % at one half), so a quarter separates doping from distinct compounds.
+"""
+
+from itertools import combinations
+
+import numpy as np
+from pymatgen.core import Element, Structure
+
+RADIUS_TOLERANCE = 0.3
+ELECTRONEGATIVITY_TOLERANCE = 1.0
+DILUTE_FRACTION = 0.25
+
+
+def substitutable(first: Element, second: Element) -> bool:
+    try:
+        radius = abs(first.atomic_radius - second.atomic_radius) / np.mean(
+            [first.atomic_radius, second.atomic_radius]
+        )
+        return radius <= RADIUS_TOLERANCE and abs(first.X - second.X) <= ELECTRONEGATIVITY_TOLERANCE
+    except (TypeError, ValueError):
+        return False
+
+
+def dissimilarity(first: Element, second: Element) -> float:
+    """Distance within the substitution rule: 0 for identical elements, at most 2 when substitutable."""
+    radius = abs(first.atomic_radius - second.atomic_radius) / np.mean(
+        [first.atomic_radius, second.atomic_radius]
+    )
+    return radius / RADIUS_TOLERANCE + abs(first.X - second.X) / ELECTRONEGATIVITY_TOLERANCE
+
+
+def _dilute_pairs(structure: Structure) -> list[tuple[Element, Element]]:
+    """(host, substituent) pairs where the substituent is dilute, the most similar host first."""
+    composition = structure.composition
+    pairs = []
+    for first, second in combinations(sorted(composition.elements), 2):
+        if not substitutable(first, second):
+            continue
+        for host, guest in ((first, second), (second, first)):
+            share = composition[guest] / (composition[host] + composition[guest])
+            if share <= DILUTE_FRACTION + 1e-9:
+                pairs.append((dissimilarity(host, guest), share, str(host), str(guest), host, guest))
+    return [(host, guest) for *_, host, guest in sorted(pairs, key=lambda item: item[:4])]
+
+
+def dilute_variants(structure: Structure) -> list[Structure]:
+    """Each dilute substituent merged into its host, one pair at a time, then all together."""
+    variants = []
+    for host, guest in _dilute_pairs(structure):
+        variant = structure.copy()
+        variant.replace_species({guest: host})
+        variants.append(variant)
+    merged = canonical(structure)
+    if variants and merged.composition != variants[0].composition:
+        variants.append(merged)
+    return variants
+
+
+def canonical(structure: Structure) -> Structure:
+    """Merge dilute substituents into their hosts until none is left."""
+    current = structure
+    for _ in range(len(structure.composition.elements)):
+        pairs = _dilute_pairs(current)
+        if not pairs:
+            break
+        host, guest = pairs[0]
+        current = current.copy()
+        current.replace_species({guest: host})
+    return current
+
+
+class DisorderAwareMatcher:
+    """Wrap a pairwise matcher: two structures also match when their canonical forms do."""
+
+    def __init__(self, matcher):
+        self.matcher = matcher
+
+    def __getattr__(self, name):
+        return getattr(self.matcher, name)
+
+    def is_equivalent(self, first: Structure, second: Structure, *args, **kwargs) -> bool:
+        if self.matcher.is_equivalent(first, second, *args, **kwargs):
+            return True
+        first_canonical, second_canonical = canonical(first), canonical(second)
+        if first_canonical is first and second_canonical is second:
+            return False
+        if first_canonical.composition.reduced_composition != second_canonical.composition.reduced_composition:
+            return False
+        return self.matcher.is_equivalent(first_canonical, second_canonical, *args, **kwargs)
